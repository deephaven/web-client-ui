{
  "name": "@deephaven/golden-layout",
  "version": "1.32.0",
  "author": "Deephaven Data Labs LLC",
  "license": "Apache-2.0",
  "description": "A multi-screen javascript Layout manager",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "source": "src/index.ts",
  "type": "module",
  "dependencies": {
    "@deephaven/components": "file:../components",
    "jquery": "^3.6.0",
    "nanoid": "^5.0.7"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production run-p build:*",
    "build:babel": "babel ./src --out-dir ./dist --copy-files --no-copy-ignored --extensions \".ts,.js,.tsx,.jsx\" --source-maps --root-mode upward --ignore \"src/__tests__/**,src/test-utils/**\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/deephaven/web-client-ui.git",
    "directory": "packages/golden-layout"
  },
  "keywords": [
    "layout manager",
    "javascript",
    "docker",
    "layout",
    "popouts"
  ],
  "files": [
    "dist",
    "styles"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  }
}
